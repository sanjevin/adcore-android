<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sync_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/adcore_background">

    <LinearLayout
        android:id="@+id/sync_progress_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/sync_horizontal_padding"
        android:paddingTop="@dimen/sync_vertical_padding"
        android:paddingEnd="@dimen/sync_horizontal_padding"
        android:paddingBottom="@dimen/sync_vertical_padding">

        <TextView
            android:id="@+id/sync_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:includeFontPadding="true"
            android:text="@string/syncing_resources"
            android:textColor="@color/white"
            android:textSize="26sp" />

        <ScrollView
            android:id="@+id/sync_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/sync_progress_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/unmapped_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:visibility="gone">

        <TextView
            android:id="@+id/unmapped_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="true"
            android:text="@string/please_map_device_id_to_node"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/unmapped_device_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:includeFontPadding="true"
            android:textColor="@color/adcore_text_secondary"
            android:textIsSelectable="true"
            android:textSize="20sp" />

        <Button
            android:id="@+id/unmapped_refresh_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/refresh" />
    </LinearLayout>
</FrameLayout>
