<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/install_prompt_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/adcore_background">

    <LinearLayout
        android:id="@+id/install_prompt_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <ProgressBar
            android:id="@+id/install_prompt_spinner"
            android:layout_width="@dimen/login_spinner_size"
            android:layout_height="@dimen/login_spinner_size"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/install_prompt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:includeFontPadding="true"
            android:text="@string/update_ready"
            android:textColor="@color/white"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/install_prompt_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:includeFontPadding="true"
            android:maxWidth="520dp"
            android:text="@string/update_install_permission_waiting"
            android:textColor="@color/adcore_text_secondary"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
